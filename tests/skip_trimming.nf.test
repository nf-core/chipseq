nextflow_pipeline {

    name "Test pipeline with --skip_trimming"
    script "../main.nf"
    tag "skip_trimming"

    test("skip_trimming") {

        when {
            params {
                outdir = "$outputDir"
                skip_trimming = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    path("$outputDir/pipeline_info/nf_core_chipseq_software_mqc_versions.yml").readLines().first().contains("Workflow"),
                    file("$outputDir/multiqc/multiqc_report.html").name
                ).match() }
            )
        }
    }

    test("skip_trimming with stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                skip_trimming = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size()
                ).match() }
            )
        }
    }
}
