nextflow_pipeline {

    name "Test pipeline with bowtie2 aligner"
    script "../main.nf"
    tag "bowtie2"

    test("bowtie2") {

        when {
            params {
                outdir = "$outputDir"
                aligner = "bowtie2"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    path("$outputDir/pipeline_info/nf_core_chipseq_software_mqc_versions.yml").readLines().first().contains("Workflow"),
                    file("$outputDir/multiqc/multiqc_report.html").name
                ).match() }
            )
        }
    }

    test("bowtie2 with stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                aligner = "bowtie2"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size()
                ).match() }
            )
        }
    }
}
